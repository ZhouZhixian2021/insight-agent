{
  "name": "@deepseek-ai/dsh-academic-bundle",
  "description": "Academic research composition: source providers, research controller, browser interface and research preset",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/academic/bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./web.patch.yml": "./web.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "web.patch.yml",
    "presets/academic.patch.yml",
    "presets/academic/skills",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./web.patch.yml",
        "./presets/academic.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-academic-source": "workspace:*",
    "@deepseek-ai/dsh-academic-source-acl": "workspace:*",
    "@deepseek-ai/dsh-academic-source-arxiv": "workspace:*",
    "@deepseek-ai/dsh-academic-source-browser": "workspace:*",
    "@deepseek-ai/dsh-academic-source-cvf": "workspace:*",
    "@deepseek-ai/dsh-academic-source-openalex": "workspace:*",
    "@deepseek-ai/dsh-academic-source-pmlr": "workspace:*",
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-api-academic-research-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-academic-research": "workspace:*",
    "@deepseek-ai/dsh-command-compact": "workspace:*",
    "@deepseek-ai/dsh-compaction-basic": "workspace:*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-plan-mode": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "@deepseek-ai/dsh-academic-client-remote": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
