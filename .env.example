# 本文件为环境变量样例：复制为 .env 后填入真实值。
# .env 已被 git 忽略，不会提交；本文件本身不含任何密钥。
#
# Windows PowerShell 也可以只在当前终端设置：
#   $env:WOWEI_GATE_API_KEY = '你的key'

# 产品洞察使用的模型网关密钥。
# 变量名必须与 .dsh-runtime/profiles/web/cordis.patch.yml 里的 apiKeyEnv 一致。
WOWEI_GATE_API_KEY=

# 上游默认模型服务的密钥与地址，仅在上游测试或 e2e 场景需要；不影响产品洞察。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=

# 运行时目录，默认是仓库内的 .dsh-runtime，通常不需要设置。
# DSH_HOME=
