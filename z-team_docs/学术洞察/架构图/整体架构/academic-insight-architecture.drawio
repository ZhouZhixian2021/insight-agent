      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="academic-handoff" name="03 成员分工、交接与设计取舍">
    <mxGraphModel dx="1660" dy="1810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1810" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03 成员分工、交接与设计取舍" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243342;fontStyle=1;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1540" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="建议分工沿用 A 集成与共享模型、B 来源与证据、C 分析报告与页面；以共同样例和独立验收汇合，不新增已完成承诺" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1540" height="48" as="geometry" />
        </mxCell>
        <mxCell id="TEAM-A" value="成员 A｜共享规则与系统集成" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="TEAM-A-body" value="计划审批、循环轮次、预算与恢复&#xa;共享证据模型、版本与存储接口&#xa;领域勘察和循环补证的整体接入&#xa;上游升级检查、跨模块联调&#xa;交付：接口样例、事件说明、端到端结果" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="TEAM-A">
          <mxGeometry x="20" y="60" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="TEAM-B" value="成员 B｜来源、论文与证据" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="580" y="145" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="TEAM-B-body" value="多来源检索、授权材料与全文获取&#xa;按质量缺口定向补检、补读与核验&#xa;来源身份、原文位置、更新与去重&#xa;真实论文召回、误排除与耗时复测&#xa;交付：规范记录、证据样本、失败清单" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="TEAM-B">
          <mxGeometry x="20" y="60" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="TEAM-C" value="成员 C｜分析、报告与用户体验" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1100" y="145" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="TEAM-C-body" value="领域方向展示、计划和报告交互&#xa;质量缺口评估、更新论断与重新成文&#xa;报告版本、图表、导出与差异展示&#xa;补证前后质量对比和浏览器验收&#xa;交付：报告样例、评测结果、可用界面" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="TEAM-C">
          <mxGeometry x="20" y="60" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="HANDOFF" value="共同交接对象：现有记录优先复用，新增字段由 A 统一确认" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="1540" height="395" as="geometry" />
        </mxCell>
        <mxCell id="I1" value="研究需求与批准&#xa;计划身份／版本／范围／问题／日期政策&#xa;领域勘察结果与第二次批准准确绑定&#xa;计划变化不得继续沿用旧批准" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="HANDOFF">
          <mxGeometry x="20" y="55" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="I2" value="论文、版本与来源&#xa;论文身份、版本、来源及内容哈希&#xa;原始获取时间、日期口径和可用状态&#xa;未知、失败与未处理必须分别保留" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="HANDOFF">
          <mxGeometry x="530" y="55" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="I3" value="证据与支持关系&#xa;逐字摘录、原文位置与证据等级&#xa;关联问题／方面、实验条件及反证&#xa;原文定位有效不等于语义一定支持" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="HANDOFF">
          <mxGeometry x="1040" y="55" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="I4" value="运行、预算与恢复&#xa;运行身份、补证轮次、额度与停止原因&#xa;缺口清单、新增证据和失败分别保存&#xa;恢复不重置预算，也不串用其他研究" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="HANDOFF">
          <mxGeometry x="20" y="220" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="I5" value="共享证据复用（规划）&#xa;版本化读写接口、适用性与来源权限&#xa;新证据追加，旧结论可追溯和标记过时&#xa;来源缓存与共享证据库分开管理" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="HANDOFF">
          <mxGeometry x="530" y="220" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="I6" value="分析、报告与审核&#xa;报告引用、方向覆盖和内容限制&#xa;交付状态与独立语义／人工审核分开&#xa;图表、正文、导出使用同一证据版本" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="HANDOFF">
          <mxGeometry x="1040" y="220" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="DECISIONS" value="方案与调研存在分歧时的建议取舍：以本项目的固定样本验证" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="1540" height="440" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="流程与 Agent&#xa;&#xa;保留现有确定性流程、审批和有界补强。&#xa;子 Agent 用于隔离阅读上下文，&#xa;输入自包含、输出结构化、预算可追踪。&#xa;不重写 dsh 主循环、工具和会话底座。&#xa;“每篇一个 Agent”先与现有并发做对照。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="DECISIONS">
          <mxGeometry x="20" y="55" width="480" height="350" as="geometry" />
        </mxCell>
        <mxCell id="D2" value="审核与写作&#xa;&#xa;继续执行引用、版本与结构检查。&#xa;增量补充语义、数字核对和人工审阅。&#xa;独立批判 Agent、逐节审批、分章写作&#xa;列为可选策略，不默认强制串入主流程。&#xa;避免用固定字数或新增审批代替质量。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="DECISIONS">
          <mxGeometry x="530" y="55" width="480" height="350" as="geometry" />
        </mxCell>
        <mxCell id="D3" value="证据库与检索&#xa;&#xa;先稳定字段、读写和可查询持久化，&#xa;再逐步接入跨研究复用和索引。&#xa;向量索引须具备服务、预算和对照收益；&#xa;不把缓存命中视为研究结论可直接复用。&#xa;“10分钟”“全领域覆盖”需另行真实验收。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="DECISIONS">
          <mxGeometry x="1040" y="55" width="480" height="350" as="geometry" />
        </mxCell>
        <mxCell id="SOURCES" value="资料依据与状态口径" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="1360" width="1540" height="360" as="geometry" />
        </mxCell>
        <mxCell id="sources-left" value="目标与策略资料（ziliao）&#xa;insight-agent-proposal.md：共享证据与分组业务&#xa;deep-research-plan.md：只开发研究策略层&#xa;research/strategy-comparison.md：策略对比与取舍&#xa;research/项目研究（竞品分析）.md：观察与设计线索&#xa;以上为本地调研资料，不作为外部产品当前能力证明。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="SOURCES">
          <mxGeometry x="20" y="60" width="735" height="240" as="geometry" />
        </mxCell>
        <mxCell id="sources-right" value="实现与验收资料（insight-agent）&#xa;docs/academic-insight-plan.zh.md：M0—M4目标，旧进度不沿用&#xa;docs/subsystems/academic-insight.zh.md：当前模块与接口&#xa;docs/upgrade-guide/：日期、覆盖、定向补强、后台进度&#xa;docs/persistence-changes/2026-11-02-academic-domain-survey.zh.md&#xa;z-team_docs/开发记录/2026-11-02-yzyhello-抽取派发按问题检索排序.md&#xa;Git主分支为依据；领域勘察说明中含未提交实现。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="SOURCES">
          <mxGeometry x="775" y="60" width="745" height="270" as="geometry" />
        </mxCell>
        <mxCell id="note" value="边界：正文依据来源记录；元数据勘察不充当全文证据；没有完整真实验收的功能不标记为“质量已达标”。分工与顺序为本次建议。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1745" width="1540" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="academic-evidence-loop" name="04 循环补证与报告质量提升">
    <mxGraphModel dx="1225" dy="678" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243342;fontStyle=1;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="04 循环补证与报告质量提升" vertex="1">
          <mxGeometry height="48" width="1540" x="60" y="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="目的：围绕报告的具体缺口补充有效证据，再更新分析与报告｜已有有界补强作为基础；下方完整多轮反馈为 P2 规划" vertex="1">
          <mxGeometry height="48" width="1540" x="60" y="80" as="geometry" />
        </mxCell>
        <mxCell id="LOOP-BASE" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="已有基础：复用现有流程与记录，不重复建设底座" vertex="1">
          <mxGeometry height="170" width="1540" x="60" y="145" as="geometry" />
        </mxCell>
        <mxCell id="EXISTING" parent="LOOP-BASE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" value="【已合入】计划审批、按问题选段、问题／方面覆盖检查、定向有界补强&#xa;证据与论文版本关联、原文定位核验、运行预算与恢复、单篇深入补充&#xa;【本次规划】把分析后的论断和数据缺口反馈到补检／补读，并支持多轮重分析与报告更新" vertex="1">
          <mxGeometry height="100" width="1500" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="CYCLE" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="规划闭环：每轮都有具体目标、新增材料记录和质量复核" vertex="1">
          <mxGeometry height="810" width="1540" x="60" y="350" as="geometry" />
        </mxCell>
        <mxCell id="REWRITE" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="① 更新分析与报告草稿&#xa;根据当前有效证据回答研究问题&#xa;新增证据只更新受影响的论断&#xa;无有效证据时仅保留问题与缺口" vertex="1">
          <mxGeometry height="160" width="420" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="CHECK" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="② 检查报告质量&#xa;哪些问题没答、哪些结论缺少依据&#xa;数字与实验条件是否完整一致&#xa;有无相反发现、范围和引用问题" vertex="1">
          <mxGeometry height="160" width="440" x="550" y="80" as="geometry" />
        </mxCell>
        <mxCell id="DECIDE" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="③ 确定是否继续补证&#xa;按缺口的重要性排序&#xa;核对批准范围、预算和新增信息&#xa;允许继续才进入下一轮" vertex="1">
          <mxGeometry height="160" width="420" x="1090" y="80" as="geometry" />
        </mxCell>
        <mxCell id="GATHER" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="④ 定向补检或补读&#xa;把缺口转成查询和阅读目标&#xa;优先补读已有论文，再按需补检&#xa;补足实验数据、比较条件和反证" vertex="1">
          <mxGeometry height="160" width="420" x="1090" y="380" as="geometry" />
        </mxCell>
        <mxCell id="VERIFY" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="⑤ 核验新增材料&#xa;核对来源、论文版本与原文位置&#xa;判断是否真正支持对应论断&#xa;区分重复、无效、矛盾和有效证据" vertex="1">
          <mxGeometry height="160" width="440" x="550" y="380" as="geometry" />
        </mxCell>
        <mxCell id="MERGE" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="⑥ 合并证据并记录本轮结果&#xa;追加有效证据，保留原有材料&#xa;记录新增、失败、缺口与已用预算&#xa;更新支持关系，再回到分析环节" vertex="1">
          <mxGeometry height="160" width="420" x="30" y="380" as="geometry" />
        </mxCell>
        <mxCell id="RESULT" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="收尾与交付&#xa;按批准要求判断正式报告或草稿&#xa;披露剩余缺口、限制及停止原因&#xa;零有效证据不生成研究结论" vertex="1">
          <mxGeometry height="130" width="420" x="1090" y="650" as="geometry" />
        </mxCell>
        <mxCell id="QUALITY-AIM" parent="CYCLE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="补证目标是提高依据的充分性、结论的可信度和报告的完整性。&#xa;发现反证时允许修正或撤回旧论断，不把“论文更多”当成质量更好。&#xa;每轮保留证据和报告版本，便于比较改善在哪里、付出了多少额外成本。" vertex="1">
          <mxGeometry height="130" width="960" x="30" y="650" as="geometry" />
        </mxCell>
        <mxCell id="STOPS" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="停止条件与交付边界&#xa;&#xa;达到获批的交付要求，或&#xa;达到轮次／调用／耗时／额度上限，或&#xa;满足配置的“无新增有效信息”条件，&#xa;以及用户取消、不可恢复故障。&#xa;&#xa;预算停止不代表质量已经合格；&#xa;未解决问题必须留在交付说明中。" vertex="1">
          <mxGeometry height="320" width="500" x="60" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="GUARDS" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="范围、失败与恢复&#xa;&#xa;补证围绕已批准的问题和范围执行。&#xa;新增方向或扩大范围需再次批准。&#xa;无效证据不纳入结论；失败不清空&#xa;旧证据和已保存的报告版本。&#xa;&#xa;保存轮次、缺口、操作、预算和版本；&#xa;恢复后继续未完成工作，不重置额度。" vertex="1">
          <mxGeometry height="320" width="500" x="580" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="OWNERS" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="成员分工与交接&#xa;&#xa;A：循环调度、批准绑定、预算、&#xa;检查点恢复和整体接入。&#xa;B：按缺口补检、补读，核验新证据。&#xa;C：评估缺口、更新分析与报告，&#xa;比较补证前后的质量。&#xa;&#xa;共同交接：缺口清单、有效证据、&#xa;停止原因、报告版本和质量变化。" vertex="1">
          <mxGeometry height="320" width="500" x="1100" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="LOOP-ACCEPT" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="如何验收：使用相同计划和初始材料，对比关闭与开启循环的结果" vertex="1">
          <mxGeometry height="220" width="1540" x="60" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="MEASURES" parent="LOOP-ACCEPT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="人工核对：问题回答完整性、论断支持是否充分、引用是否准确、数字与实验条件是否一致、是否披露冲突。&#xa;同时记录：新增有效证据、已解决／仍未解决的缺口、额外调用、耗时与成本；不只看论文数量和自动评分。&#xa;固定场景覆盖：补证成功、只找到重复材料、检索失败、预算耗尽、取消恢复、出现反证、零有效证据。&#xa;先完成固定材料对照，再验证真实论文与真实模型；如无质量增益，调整补证策略和停止条件。" vertex="1">
          <mxGeometry height="145" width="1500" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="loop-note" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="注：流程编号是单轮执行顺序。首次分析使用已有有效证据；每次循环均复核实际质量，不保证增加轮数就一定提高质量。" vertex="1">
          <mxGeometry height="45" width="1540" x="60" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="loop-1" edge="1" parent="1" source="REWRITE" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="CHECK" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loop-2" edge="1" parent="1" source="CHECK" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="DECIDE" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loop-3" edge="1" parent="1" source="DECIDE" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="GATHER" value="有缺口且允许继续">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="loop-4" edge="1" parent="1" source="GATHER" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="VERIFY" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loop-5" edge="1" parent="1" source="VERIFY" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="MERGE" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loop-6" edge="1" parent="1" source="MERGE" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="REWRITE" value="带着新增证据再次分析">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="loop-stop" edge="1" parent="1" source="DECIDE" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="RESULT" value="达到要求或触发停止条件">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-150" y="91" as="offset" />
            <Array as="points">
              <mxPoint x="1620" y="510" />
              <mxPoint x="1620" y="955" />
              <mxPoint x="1360" y="955" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="academic-domain-survey" name="05 领域勘察与深入研究架构">
    <mxGraphModel dx="1753" dy="971" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243342;fontStyle=1;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="05 领域勘察与深入研究架构" vertex="1">
          <mxGeometry height="48" width="1540" x="60" y="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="核对日期：2026-11-03｜橙色为本地未提交实现，绿色为复用的已合入能力，蓝色虚线为后续规划；真实端到端效果仍待验收" vertex="1">
          <mxGeometry height="48" width="1540" x="60" y="80" as="geometry" />
        </mxCell>
        <mxCell id="D5-BASE" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="公共基座：沿用现有审批、来源、模型与会话服务" vertex="1">
          <mxGeometry height="145" width="1540" x="60" y="150" as="geometry" />
        </mxCell>
        <mxCell id="D5-SHARED" parent="D5-BASE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" value="Plan 审批与 Session 日志｜学术来源接口｜模型调用与有限重试｜维护任务、超时与事件持久化&#xa;领域勘察复用这些能力；新增计划、方向图谱、绑定校验和页面在本地工作区开发。" vertex="1">
          <mxGeometry height="75" width="1500" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="D5-SURVEY" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="阶段一：单独批准元数据勘察，发现有出处的候选方向" vertex="1">
          <mxGeometry height="550" width="1540" x="60" y="340" as="geometry" />
        </mxCell>
        <mxCell id="D5-PLAN1" parent="D5-SURVEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="① 用户需求 → 勘察计划&#xa;明确主题、范围、年份和论文版本&#xa;列出方向发现与独立遗漏复查查询&#xa;披露候选数量、查询和总耗时上限&#xa;执行块：academic-domain-survey-json" vertex="1">
          <mxGeometry height="160" width="460" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-APPROVE1" parent="D5-SURVEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="② 第一次用户批准&#xa;读取会话中明确批准的计划结果&#xa;校验正文、查询、日期与预算一致&#xa;生成与本次批准绑定的 planId&#xa;未批准或计划标识过期时拒绝执行" vertex="1">
          <mxGeometry height="160" width="460" x="540" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-SEARCH" parent="D5-SURVEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="③ 执行已批准的学术查询&#xa;academicSource.searchAll&#xa;依次执行发现与遗漏复查查询&#xa;记录来源失败、截断等限制&#xa;本阶段不下载全文或生成研究结论" vertex="1">
          <mxGeometry height="160" width="460" x="1060" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-SELECT" parent="D5-SURVEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="④ 整理论文与所选版本&#xa;去重、核对日期和版本条件&#xa;轮流从不同查询中选取候选&#xa;为遗漏复查结果保留进入候选池的机会&#xa;保留标题、摘要、来源与版本身份&#xa;限制候选数量，披露政策排除数" vertex="1">
          <mxGeometry height="190" width="460" x="1060" y="310" as="geometry" />
        </mxCell>
        <mxCell id="D5-MAP" parent="D5-SURVEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="⑤ 模型整理候选方向&#xa;只使用所给标题和摘要，按问题归类&#xa;产出名称、定义及逐字摘录支持&#xa;一篇论文可支持多个方向&#xa;无法可靠归类的论文进入未分类清单&#xa;请求、响应和失败写入会话日志" vertex="1">
          <mxGeometry height="190" width="460" x="540" y="310" as="geometry" />
        </mxCell>
        <mxCell id="D5-CHECK" parent="D5-SURVEY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="⑥ 核对图谱与原始元数据&#xa;论文身份必须存在，摘录必须能定位&#xa;方向名称不重复，方向必须有支持材料&#xa;每篇候选均须归类或标记未分类&#xa;原文匹配只是出处核验&#xa;方向归类是否合理仍需质量验收" vertex="1">
          <mxGeometry height="190" width="460" x="20" y="310" as="geometry" />
        </mxCell>
        <mxCell id="D5-REVIEW" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="阶段二：审阅图谱与遗漏，重新批准逐方向研究计划" vertex="1">
          <mxGeometry height="260" width="1540" x="60" y="940" as="geometry" />
        </mxCell>
        <mxCell id="D5-SAVED" parent="D5-REVIEW" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="⑦ 保存并展示勘察结果&#xa;保存 mapped / incomplete 状态&#xa;展示方向、出处、未分类论文与限制&#xa;DomainSurveyCard 可读取历史结果&#xa;图谱只表示本次候选材料中的方向&#xa;无方向时先调整勘察计划再审批" vertex="1">
          <mxGeometry height="175" width="460" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-PLAN2" parent="D5-REVIEW" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="⑧ 制定逐方向深入研究计划&#xa;每个方向标为深入、概览或不覆盖&#xa;深入方向绑定独立问题与证据目标&#xa;逐方向设查询上限，披露全局预算&#xa;保留证据缺口补检轮次&#xa;同时说明未分类论文与勘察限制" vertex="1">
          <mxGeometry height="175" width="460" x="540" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-APPROVE2" parent="D5-REVIEW" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="⑨ 第二次用户批准&#xa;单独批准 Research Brief 版本 9 计划&#xa;绑定准确的 surveyPlanId&#xa;保留图谱中所有方向的身份与名称&#xa;正文、方向分配、查询和预算须一致&#xa;第一次批准不能直接授权深入研究" vertex="1">
          <mxGeometry height="175" width="460" x="1060" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-DEEP" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="阶段三：把获批方向交给已有全文证据流程，逐方向核对交付" vertex="1">
          <mxGeometry height="290" width="1540" x="60" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="D5-BIND" parent="D5-DEEP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="⑩ 启动前核对绑定关系&#xa;勘察结果须存在于当前会话&#xa;方向身份、名称、数量与图谱一致&#xa;核对最新获批的 researchBriefId&#xa;控制器带入真实勘察状态与限制&#xa;拒绝缺失、改名或被悄悄省略的方向" vertex="1">
          <mxGeometry height="200" width="460" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-EXECUTE" parent="D5-DEEP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" value="⑪ 复用已合入的全文证据流程&#xa;按获批查询 → 筛选 → 全文 → 证据&#xa;进行问题关联、分析与有界补强&#xa;【本地接入】按方向安排查询轮次&#xa;概览与不覆盖方向不分配深研查询&#xa;方向图谱不计作全文证据" vertex="1">
          <mxGeometry height="200" width="460" x="540" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-REPORT" parent="D5-DEEP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="⑫ 报告逐方向披露结果&#xa;只统计与问题关联且被报告引用的&#xa;全文证据论文，按论文身份去重&#xa;对比批准目标，显示缺口与实际引用&#xa;深入方向未达目标列为交付未达标&#xa;同时披露勘察不完整及未分类材料" vertex="1">
          <mxGeometry height="200" width="460" x="1060" y="60" as="geometry" />
        </mxCell>
        <mxCell id="D5-BOUNDARY" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="当前能力边界与下一步完善" vertex="1">
          <mxGeometry height="260" width="1540" x="60" y="1585" as="geometry" />
        </mxCell>
        <mxCell id="D5-CURRENT" parent="D5-BOUNDARY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="当前本地实现&#xa;同一批准可复用已保存图谱，执行中的重复请求共用任务。&#xa;模型连接或输出截断进行有限重试，必要时缩短摘要输入。&#xa;勘察查询中间结果尚无断点；失败后不能承诺逐查询续跑。&#xa;mapped 仅表示没有已记录限制，不等于穷尽整个领域。" vertex="1">
          <mxGeometry height="180" width="730" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="D5-NEXT" parent="D5-BOUNDARY" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="待验收／规划&#xa;优先验证真实来源与模型下的两次审批和逐方向报告。&#xa;核对历史重开、部分来源失败、范围变更及方向质量。&#xa;再评估查询级检查点、进度与专用取消入口。&#xa;报告后的多轮循环补证沿用第 04 页规划，不计作本期完成。" vertex="1">
          <mxGeometry height="180" width="745" x="775" y="55" as="geometry" />
        </mxCell>
        <mxCell id="D5-NOTE" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="阅读顺序：①—⑥ 先整理候选方向，⑦—⑨ 由用户决定研究深度，⑩—⑫ 再用全文证据形成报告。数据、状态和验收细节见第 06 页。" vertex="1">
          <mxGeometry height="55" width="1540" x="60" y="1870" as="geometry" />
        </mxCell>
