        <mxCell id="P2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="P2  循环补证与可信交付&#xa;后续规划" vertex="1">
