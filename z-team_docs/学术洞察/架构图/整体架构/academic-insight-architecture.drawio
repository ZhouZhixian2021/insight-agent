  <diagram id="academic-domain-survey-contracts" name="06 领域勘察审批、数据与异常处理">
    <mxGraphModel dx="1660" dy="2020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="06 领域勘察审批、数据与异常处理" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243342;fontStyle=1;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1540" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="核对日期：2026-11-03｜依据当前本地代码说明，不把流程阶段当作新增状态枚举；勘察专属实现尚未提交合入" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1540" height="48" as="geometry" />
        </mxCell>
        <mxCell id="D6-IDENTITY" value="审批与身份链：每一步都能回到明确批准及已保存结果" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="1540" height="250" as="geometry" />
        </mxCell>
        <mxCell id="D6-APPROVAL" value="明确批准记录&#xa;exit_plan_mode 成功结果&#xa;meta.approved = true&#xa;绑定对应调用身份与计划正文&#xa;普通聊天表态不是此执行凭据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-IDENTITY">
          <mxGeometry x="20" y="55" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-PLANID" value="勘察身份 planId&#xa;sessionId + approved-survey&#xa;+ 本次批准 identity&#xa;启动请求须匹配最新获批计划&#xa;不同批准不会共用同一身份" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="D6-IDENTITY">
          <mxGeometry x="390" y="55" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-SAVED" value="持久化勘察结果&#xa;完成图谱事件写入 Session&#xa;domainSurveys[planId]&#xa;保留主题、条件、查询与结果&#xa;只有已保存图谱才能被绑定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="D6-IDENTITY">
          <mxGeometry x="760" y="55" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-BIND" value="深入研究的第二次批准&#xa;domainResearchPlan.surveyPlanId&#xa;逐项核对 directionId 与 label&#xa;全部方向都有深度分配&#xa;通过后才执行获批研究计划" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="D6-IDENTITY">
          <mxGeometry x="1130" y="55" width="390" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-DATA" value="关键交接数据：标题摘要图谱、批准计划、全文证据分别保存" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="1540" height="440" as="geometry" />
        </mxCell>
        <mxCell id="D6-DATA1" value="ApprovedDomainSurveyPlan｜勘察计划&#xa;planId / topic / scope / reviewedAt&#xa;selection：年份、日期口径、论文版本&#xa;queries：expression / purpose / roundIndex&#xa;limits：候选、每条结果与总耗时上限" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-DATA">
          <mxGeometry x="20" y="55" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-DATA2" value="DomainSurveyPaper｜候选材料&#xa;workId / title / abstract&#xa;workVersionId / versionType / publicationDate&#xa;sourceProviders / sourceRecords&#xa;缺少摘要可用标题；不把元数据升为全文证据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-DATA">
          <mxGeometry x="540" y="55" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-DATA3" value="DomainSurveyDirection｜候选方向&#xa;directionId / label / definition / supports&#xa;support：workId / field / quote&#xa;身份由规范化名称与支持论文身份生成&#xa;一篇可属多方向，但不能又列为未分类" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-DATA">
          <mxGeometry x="1060" y="55" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-DATA4" value="DomainSurveyResult｜勘察结果&#xa;status：mapped 或 incomplete&#xa;queries / papers / map / limitations&#xa;map 含 directions 与 unclassifiedWorkIds&#xa;excludedByPolicy：日期或版本政策排除数" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-DATA">
          <mxGeometry x="20" y="250" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-DATA5" value="DomainResearchPlan｜深研安排&#xa;surveyPlanId + 每个方向的身份、名称与 depth&#xa;question / targetSupportingWorks&#xa;maximumQueries；scopeDecision 同步分配&#xa;控制器填入真实状态、限制与未分类数量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-DATA">
          <mxGeometry x="540" y="250" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-DATA6" value="报告核对｜从证据回到方向&#xa;direction.question → questionLinks.evidenceId&#xa;只计报告引用且 level = fulltext 的证据&#xa;academicWorkId 去重后与计划目标比较&#xa;不足、概览、不覆盖与勘察限制分别说明" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-DATA">
          <mxGeometry x="1060" y="250" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="D6-STATES" value="执行与读取：不完整的可用结果，与没有完成图谱的失败分开处理" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="930" width="1540" height="400" as="geometry" />
        </mxCell>
        <mxCell id="D6-ADMIT" value="入场校验&#xa;检查批准、计划身份、来源和模型&#xa;缺少或不匹配时直接拒绝&#xa;不把旧批准用于新的勘察计划" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="D6-STATES">
          <mxGeometry x="20" y="55" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="D6-RUN" value="任务运行&#xa;同批准的并发请求复用活动任务&#xa;接纳后由维护任务与总时限控制&#xa;页面关闭不等于后端任务已取消" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="D6-STATES">
          <mxGeometry x="390" y="55" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="D6-SETTLED" value="验证后保存结果&#xa;来源失败、截断等可形成受限结果&#xa;模型或图谱校验失败不写完成图谱&#xa;已存在的历史图谱保持可读取" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="D6-STATES">
          <mxGeometry x="760" y="55" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="D6-READ" value="结果读取与复用&#xa;getDomainSurvey 只读取已保存结果&#xa;同批准再次执行可返回既有结果&#xa;历史结果可读，不替换最新批准" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="D6-STATES">
          <mxGeometry x="1130" y="55" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="D6-FAIL" value="失败与中断&#xa;模型有限重试后仍失败、总超时或维护任务中止：不写完成图谱。&#xa;已有模型请求／结果日志可追查；查询中间结果尚未持久化。&#xa;当前重新尝试会重新检索，不能承诺从上一条查询继续。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-STATES">
          <mxGeometry x="20" y="230" width="710" height="130" as="geometry" />
        </mxCell>
        <mxCell id="D6-RESULTS" value="结果状态的含义&#xa;mapped：没有已记录限制；incomplete：来源失败、截断、无方向等。&#xa;incomplete 仍可能保留有效方向，可交由第二次审批评估。&#xa;二者都不是“领域已穷尽”或“全文研究已经完成”的标志。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-STATES">
          <mxGeometry x="760" y="230" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="D6-ACCEPT" value="当前约束、验收重点与团队交接" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="1365" width="1540" height="390" as="geometry" />
        </mxCell>
        <mxCell id="D6-LIMITS" value="当前计划校验上限&#xa;&#xa;勘察：2—12 条查询，最多 4 轮，&#xa;每轮最多 3 条，后续轮次须做遗漏复查。&#xa;候选最多 40 篇，每条结果最多 30 条，&#xa;总耗时最多 60 分钟；实际按批准值执行。&#xa;深研：每个深入方向目标 1—5 篇，&#xa;最多 1—3 条查询；总查询最多 12 条，&#xa;每轮最多 3 条，并预留补检轮次。&#xa;&#xa;以上是允许上限，不是默认值或交付保证。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-ACCEPT">
          <mxGeometry x="20" y="55" width="480" height="310" as="geometry" />
        </mxCell>
        <mxCell id="D6-QA" value="优先补齐的验收&#xa;&#xa;真实来源与真实模型跑通两次审批。&#xa;对照核查方向是否合理、是否遗漏重要方向。&#xa;覆盖日期未知、重复版本、来源失败与截断。&#xa;确认伪造摘录、方向缺失或改名被拒绝。&#xa;核对历史重开、同批准复用与计划变更。&#xa;按方向核对报告的全文引用数与缺口。&#xa;&#xa;文档记录已有定向测试与类型构建；&#xa;真实勘察及大规模历史重开仍待验证。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="D6-ACCEPT">
          <mxGeometry x="530" y="55" width="480" height="310" as="geometry" />
        </mxCell>
        <mxCell id="D6-TEAM" value="建议分工与共同样例&#xa;&#xa;A：两次审批、身份绑定、控制器、&#xa;持久化事件、运行与整体联调。&#xa;B：查询、去重、日期版本筛选、&#xa;候选平衡、方向出处核验与真实来源复测。&#xa;C：勘察卡、方向和限制展示、&#xa;逐方向报告与实际引用核对。&#xa;&#xa;共同交付：同一勘察计划、候选和图谱、&#xa;第二次获批计划、报告及异常场景记录。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="D6-ACCEPT">
          <mxGeometry x="1040" y="55" width="480" height="310" as="geometry" />
        </mxCell>
        <mxCell id="D6-EVENTS" value="持久化事件（本地新增）&#xa;academic/domain-survey-request-v1&#xa;academic/domain-survey-result-v1&#xa;academic/domain-survey-completed-v1&#xa;分别保存模型输入、模型结果与已核验图谱。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1790" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="D6-SOURCES" value="核对依据（insight-agent 工作区，2026-11-03）&#xa;academic/retrieval/src/domain-survey.ts；academic-research-controller/src/&#xa;domain-survey-plan.ts、domain-survey-model.ts、domain-research-binding.ts&#xa;ui-academic-research/src/client/DomainSurveyCard.tsx；academic/report/src/index.ts&#xa;docs/subsystems/academic-insight.zh.md；领域勘察与深入研究计划模板&#xa;docs/persistence-changes/2026-11-02-academic-domain-survey.zh.md" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="1790" width="830" height="150" as="geometry" />
        </mxCell>
        <mxCell id="D6-NOTE" value="边界：模型把标题摘要分成方向，程序核对身份、摘录与账目完整性；科学分类质量与覆盖程度需要真实样本及人工判断。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1960" width="1540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="d6-id-1" source="D6-APPROVAL" target="D6-PLANID" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
