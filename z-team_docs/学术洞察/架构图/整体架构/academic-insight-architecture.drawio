        <mxCell id="head-2" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="完成条件／验收材料" vertex="1">
          <mxGeometry height="45" width="510" x="810" y="340" as="geometry" />
        </mxCell>
        <mxCell id="head-3" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="建议分工" vertex="1">
          <mxGeometry height="45" width="280" x="1320" y="340" as="geometry" />
        </mxCell>
        <mxCell id="P0-label" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="P0&#xa;可靠性与真实验收&#xa;&#xa;当前收尾；基础是已合入&#xa;代码" vertex="1">
          <mxGeometry height="260" width="240" x="60" y="385" as="geometry" />
        </mxCell>
        <mxCell id="P0-work" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="同题同计划复测范围误暂停与漏筛&#xa;解释最低篇数、目标篇数及停止原因&#xa;补全文失败分类、限流与恢复场景&#xa;建立补证前后质量、耗时与调用基线" vertex="1">
          <mxGeometry height="260" width="510" x="300" y="385" as="geometry" />
        </mxCell>
        <mxCell id="P0-gate" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="每篇未纳入原因可解释且可追溯&#xa;零证据不生成结论，缺口如实展示&#xa;取消／恢复保留已验证材料与已用预算&#xa;记录耗时、调用、覆盖与人工核对结果" vertex="1">
          <mxGeometry height="260" width="510" x="810" y="385" as="geometry" />
        </mxCell>
        <mxCell id="P0-owner" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="A：状态、预算、恢复和集成&#xa;B：来源、筛选和真实复测&#xa;C：报告核对与浏览器验收" vertex="1">
          <mxGeometry height="260" width="280" x="1320" y="385" as="geometry" />
        </mxCell>
        <mxCell id="P1-label" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" value="P1&#xa;领域勘察与多方向研究&#xa;&#xa;本地在研；沿用 P0 验收&#xa;基线" vertex="1">
          <mxGeometry height="260" width="240" x="60" y="645" as="geometry" />
        </mxCell>
        <mxCell id="P1-work" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="先审元数据勘察，再审深入研究计划&#xa;保存候选方向、未分类材料与出处&#xa;逐方向分配查询、证据目标和预算&#xa;贯通页面、计划绑定和报告缺口展示" vertex="1">
          <mxGeometry height="260" width="510" x="300" y="645" as="geometry" />
        </mxCell>
        <mxCell id="P1-gate" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="每个候选方向均可回到标题或摘要&#xa;第二次批准准确绑定已保存的勘察&#xa;深研结论使用核验后的实际证据&#xa;两阶段真实运行与刷新恢复检查通过" vertex="1">
          <mxGeometry height="260" width="510" x="810" y="645" as="geometry" />
        </mxCell>
        <mxCell id="P1-owner" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="A：批准绑定、编排和存储事件&#xa;B：方向检索、归类与来源核验&#xa;C：勘察卡、方向选择和报告" vertex="1">
          <mxGeometry height="260" width="280" x="1320" y="645" as="geometry" />
        </mxCell>
        <mxCell id="P2-label" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="P2&#xa;循环补证与可信交付&#xa;&#xa;优先增强；依赖 P0，可与&#xa; P1 并行" vertex="1">
          <mxGeometry height="260" width="240" x="60" y="905" as="geometry" />
        </mxCell>
        <mxCell id="P2-work" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="质量检查→缺口清单→补检或补读&#xa;核验新增证据→重分析→再次核查&#xa;记录轮次、预算、支持变化与报告版本&#xa;补充语义／数字复核及可选人工审阅&#xa;图表、导出及模型策略另设对照验收" vertex="1">
          <mxGeometry height="260" width="510" x="300" y="905" as="geometry" />
        </mxCell>
        <mxCell id="P2-gate" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="每轮补证对应具体问题或论断缺口&#xa;新证据必须可定位，失败不清空旧成果&#xa;达到获批要求／预算耗尽／无增益可收尾&#xa;同计划比较完整性、支持度、数字与成本&#xa;未达交付要求保留受限结果及剩余缺口" vertex="1">
          <mxGeometry height="260" width="510" x="810" y="905" as="geometry" />
        </mxCell>
        <mxCell id="P2-owner" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="A：循环调度、预算和恢复&#xa;B：定向补检补读与证据核验&#xa;C：缺口评估、重写和质量对比" vertex="1">
          <mxGeometry height="260" width="280" x="1320" y="905" as="geometry" />
        </mxCell>
        <mxCell id="P3-label" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="P3&#xa;共享证据与跨研究复用&#xa;&#xa;依赖 P0 身份、版本与来&#xa;源规则" vertex="1">
          <mxGeometry height="260" width="240" x="60" y="1165" as="geometry" />
        </mxCell>
        <mxCell id="P3-work" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="先稳定结构化记录与统一读写接口&#xa;从现有会话／导出材料建立可查询存储&#xa;维护论文版本、原文位置和内容哈希&#xa;增量接入本地资料、授权来源与报告版本" vertex="1">
          <mxGeometry height="260" width="510" x="300" y="1165" as="geometry" />
        </mxCell>
        <mxCell id="P3-gate" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="跨两次研究可复用同版材料及证据&#xa;新任务仍重新核对相关性和批准范围&#xa;内容变化新增版本，不覆盖旧证据&#xa;可从固定证据重建报告并追踪来源" vertex="1">
          <mxGeometry height="260" width="510" x="810" y="1165" as="geometry" />
        </mxCell>
        <mxCell id="P3-owner" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="A：共享模型、存储接口和迁移&#xa;B：摄取、去重、版本与来源更新&#xa;C：证据检索、复用入口与版本查&#xa;看" vertex="1">
          <mxGeometry height="260" width="280" x="1320" y="1165" as="geometry" />
        </mxCell>
        <mxCell id="P4-label" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="P4&#xa;持续洞察与业务扩展&#xa;&#xa;依赖 P3 共享库与 P2 版&#xa;本／审核记录" vertex="1">
          <mxGeometry height="260" width="240" x="60" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="P4-work" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="订阅主题，定期发现新论文与内容更新&#xa;识别受影响结论，补证后生成版本差异&#xa;接入会议、产品和新闻的场景方法&#xa;保留增量去重、失败恢复与通知控制" vertex="1">
          <mxGeometry height="260" width="510" x="300" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="P4-gate" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="同一增量重复运行不产生重复成果&#xa;更新来源与受影响结论之间可追踪&#xa;跨业务引用仍核对范围和证据等级&#xa;定时失败、恢复与通知经过真实验收" vertex="1">
          <mxGeometry height="260" width="510" x="810" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="P4-owner" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" value="A：增量调度、版本与权限隔离&#xa;B：监测来源、更新识别及适配&#xa;C：差异报告、订阅与审核界面" vertex="1">
          <mxGeometry height="260" width="280" x="1320" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="roadmap-note" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="每阶段留存：输入材料和计划、代码版本、实际结果、失败原因、人工核对及剩余缺口。验收不以“测试数量”或“关键词命中率”替代报告质量。" vertex="1">
          <mxGeometry height="55" width="1540" x="60" y="1705" as="geometry" />
        </mxCell>
        <mxCell id="priority-0" edge="1" parent="1" source="P0" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="P1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="priority-1" edge="1" parent="1" source="P1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="P2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="priority-2" edge="1" parent="1" source="P2" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="P3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="priority-3" edge="1" parent="1" source="P3" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" target="P4" value="">
          <mxGeometry relative="1" as="geometry" />
