        <mxCell id="P4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" value="P4  持续洞察与业务扩展&#xa;后续规划" vertex="1">
          <mxGeometry height="100" width="280" x="1300" y="155" as="geometry" />
        </mxCell>
        <mxCell id="order-note" parent="1" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" value="上方表示建议优先级，具体依赖见下表。P2 基于已有有界补强扩展循环；多 Agent、向量检索和模型分层另作独立对照。" vertex="1">
