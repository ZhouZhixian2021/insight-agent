        <mxCell id="head-0" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="阶段与依赖" vertex="1">
          <mxGeometry height="45" width="240" x="60" y="340" as="geometry" />
        </mxCell>
        <mxCell id="head-1" parent="1" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" value="具体交付" vertex="1">
          <mxGeometry height="45" width="510" x="300" y="340" as="geometry" />
