  <diagram id="academic-foundation-optimization" name="08 新基座适配与优化目标架构"><mxGraphModel dx="2160" dy="2390" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="2390" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="08 新基座适配与优化目标架构" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243342;fontStyle=1;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="2040" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="目标：先收口状态读取，再完成同仓库独立启停；各阶段分别验收。&#xa;基线：2026-11-03，已合入 DSH v0.2.1-rc.2；领域勘察为未提交 WIP，本页优化均为建议。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="82" width="2040" height="56" as="geometry"/></mxCell>
<mxCell id="legend-existing" value="绿色：复用已合入能力" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="80" y="153" width="270" height="40" as="geometry"/></mxCell>
<mxCell id="legend-plan" value="蓝色虚线：建议改造／待补" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="153" width="320" height="40" as="geometry"/></mxCell>
<mxCell id="legend-risk" value="红色：当前待优化" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff0ee;strokeColor=#be8177;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="710" y="153" width="250" height="40" as="geometry"/></mxCell>
<mxCell id="legend-wip" value="橙色：未提交改动关联" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="980" y="153" width="290" height="40" as="geometry"/></mxCell>
<mxCell id="legend-priority" value="本页 P0—P3 是工程改造优先级，与第 02 页业务路线编号分别解释。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1310" y="153" width="770" height="40" as="geometry"/></mxCell>
<mxCell id="CURRENT" value="当前缺口：接口已接入，读取与组装仍有重复和耦合" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="2040" height="250" as="geometry"/></mxCell>
<mxCell id="CUR-READ" value="普通状态查询仍全量重折&#xa;plan／list／get → observeSession&#xa;projectionMode: none → 遍历全部 events&#xa;绕过已注册的增量学术投影" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff0ee;strokeColor=#be8177;strokeWidth=1;" vertex="1" parent="CURRENT"><mxGeometry x="20" y="60" width="470" height="165" as="geometry"/></mxCell>
<mxCell id="CUR-CLIENT" value="证据增强页面仍搬运完整历史&#xa;Client follow + page 拉完记录&#xa;再 projectEnhancement／排序扫描&#xa;局部页面开销随整个会话增长" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff0ee;strokeColor=#be8177;strokeWidth=1;" vertex="1" parent="CURRENT"><mxGeometry x="530" y="60" width="470" height="165" as="geometry"/></mxCell>
<mxCell id="CUR-STATE" value="读取投影也需要控制体积&#xa;recoveryRuns 累积事件与检查点&#xa;Trace 分页前仍扫描、排序&#xa;WIP 勘察结果按 planId 持续累计" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff0ee;strokeColor=#be8177;strokeWidth=1;" vertex="1" parent="CURRENT"><mxGeometry x="1040" y="60" width="470" height="165" as="geometry"/></mxCell>
<mxCell id="CUR-BUNDLE" value="学术仍嵌入共享 Web 组合&#xa;Host／UI／preset／Skills 分散接线&#xa;普通 api-remotes 硬挂学术命名空间&#xa;显示文案、计划呈现与持久化有接线" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff0ee;strokeColor=#be8177;strokeWidth=1;" vertex="1" parent="CURRENT"><mxGeometry x="1550" y="60" width="470" height="165" as="geometry"/></mxCell>
<mxCell id="READ-TARGET" value="目标 A：统一会话状态读取，向界面提供定界的小视图" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1260" height="950" as="geometry"/></mxCell>
<mxCell id="SESSION-FACTS" value="Session 事件日志&#xa;保留批准、身份和证据事实&#xa;旧日志不重写、不静默丢事件&#xa;已完成的轻量进度机制继续保留" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="20" y="65" width="350" height="120" as="geometry"/></mxCell>
<mxCell id="HOST-PROJECTION" value="已注册的 Host 学术投影（现有能力，内部状态不直接进入 wire）&#xa;增量派生：获批计划、运行索引、恢复状态、增强结果&#xa;【待优化】最新检查点＋必要校验事实／尾部事件；勘察摘要与明细分开" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="440" y="65" width="780" height="120" as="geometry"/></mxCell>
<mxCell id="LIVE-READ" value="P1｜活跃会话优先复用 stateOf&#xa;现有基座能力，无需另建全局状态缓存&#xa;【待接入】普通计划、运行查询改走已折状态&#xa;同步取得状态与水位；保留归属和审批校验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="40" y="270" width="520" height="160" as="geometry"/></mxCell>
<mxCell id="COLD-READ" value="P2｜冷历史按准确水位读取 Host 状态&#xa;【待补接口】服务端按 key 的 exact-cut 读面&#xa;由现有 prepared cache／revision／lease 管理&#xa;状态版本变化时受控重建，不发送内部全量状态&#xa;旧大日志首次打开仍可能需要完整读取" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="680" y="270" width="520" height="160" as="geometry"/></mxCell>
<mxCell id="READ-SERVICE" value="统一学术只读入口&#xa;校验 Session／run／Brief 版本／cursor，同一观察切面保持一致&#xa;只读不启动研究、不取得写句柄、不把缓存命中当成新的批准" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="180" y="520" width="900" height="130" as="geometry"/></mxCell>
<mxCell id="SAFE-VIEWS" value="给界面的轻量数据与定界查询&#xa;计划／运行摘要；增强结果按 run＋workVersion 查询&#xa;明细按需分页；Trace 使用增量索引与稳定游标&#xa;不让浏览器 follow＋page 搬运完整会话日志" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="20" y="735" width="780" height="150" as="geometry"/></mxCell>
<mxCell id="CLIENT-CARDS" value="现有研究卡片与会话资源&#xa;【待适配】共享 bootstrap／watch&#xa;多卡片不重复读取、关闭可取消读取&#xa;断开观察不取消后台研究" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="890" y="735" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="READ-NOTE" value="不能只把 projectionMode 改为 all：academicResearch 当前是 Host-only，没有可直接读取的客户端 wire。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="READ-TARGET"><mxGeometry x="20" y="900" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="BUNDLE-TARGET" value="目标 B：同仓库独立启停的 Academic bundle" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1360" y="520" width="740" height="950" as="geometry"/></mxCell>
<mxCell id="SHARED-BASE" value="现有公共基座：dsh-base ＋ dsh-web-app&#xa;保留通用会话、模型、Web、插件与客户端能力&#xa;继续通过标准 dsh web profile 启动" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="BUNDLE-TARGET"><mxGeometry x="20" y="65" width="700" height="100" as="geometry"/></mxCell>
<mxCell id="ACADEMIC-BUNDLE" value="P2｜建议新增 @deepseek-ai/dsh-academic" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="BUNDLE-TARGET"><mxGeometry x="20" y="245" width="700" height="480" as="geometry"/></mxCell>
<mxCell id="B-PRESET" value="预设与方法资源&#xa;preset id 保持 academic&#xa;persona／planning／Skills&#xa;技能根从本组合包定位" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ACADEMIC-BUNDLE"><mxGeometry x="20" y="60" width="310" height="120" as="geometry"/></mxCell>
<mxCell id="B-HOST" value="Host 研究能力&#xa;来源及 Provider／Controller&#xa;学术配置与投影注册&#xa;生成产物由所属包维护" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ACADEMIC-BUNDLE"><mxGeometry x="350" y="60" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="B-REMOTE" value="Client Remote companion&#xa;复用已有 remote.$mount()&#xa;自有依赖、挂载与 disposer&#xa;移出普通 api-remotes 的硬依赖" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ACADEMIC-BUNDLE"><mxGeometry x="20" y="210" width="310" height="145" as="geometry"/></mxCell>
<mxCell id="B-UI" value="学术 UI 插件&#xa;复用现有 Conversation／slot&#xa;自有 locale 与研究卡片&#xa;依赖 Remote companion 就绪" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ACADEMIC-BUNDLE"><mxGeometry x="350" y="210" width="330" height="145" as="geometry"/></mxCell>
<mxCell id="B-CONFIG" value="迁入业务配置与安装依赖，并核对打包后的 Skills／模板路径。&#xa;学术全文 HTTP 的特殊额度应明确配置，避免无意改变其他会话。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="ACADEMIC-BUNDLE"><mxGeometry x="20" y="385" width="660" height="70" as="geometry"/></mxCell>
<mxCell id="COMPATIBILITY" value="保留在宿主构建中的持久化兼容薄层&#xa;required 事件登记、当前 codec、V2→V3→V4 历史迁移&#xa;不随 bundle 停用删除；不能改为 ignorable 绕过校验&#xa;首期不承诺安装到未经修改的任意上游 DSH" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="BUNDLE-TARGET"><mxGeometry x="20" y="775" width="700" height="120" as="geometry"/></mxCell>
<mxCell id="ROADMAP" value="推进顺序：每阶段独立验收，优先稳定状态读取，再开放组合包独立启停" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="1520" width="2040" height="440" as="geometry"/></mxCell>
<mxCell id="P0-BASELINE" value="P0｜基线与等价标准&#xa;&#xa;小／大／旧格式会话&#xa;活跃、冷读、重启矩阵&#xa;统计扫描、读取量与峰值&#xa;协调勘察 WIP 的投影版本&#xa;&#xa;验收：同一水位结果一致&#xa;读取不写日志、不调用模型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ROADMAP"><mxGeometry x="20" y="65" width="300" height="310" as="geometry"/></mxCell>
<mxCell id="P1-LIVE" value="P1｜活跃状态快读&#xa;&#xa;复用现有 stateOf&#xa;普通查询不再全量重折&#xa;冷路径暂保正确回放&#xa;保留身份与明确批准校验&#xa;&#xa;验收：重复查询不再遍历&#xa;整份历史、不接管写句柄" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ROADMAP"><mxGeometry x="360" y="65" width="300" height="310" as="geometry"/></mxCell>
<mxCell id="P1-CLIENT" value="P1｜界面定界读取&#xa;&#xa;增强历史由 Host 派生&#xa;按 run／论文版本读取&#xa;共享 bootstrap 与订阅&#xa;传播取消信号、按需加载&#xa;&#xa;验收：多卡不翻倍查询&#xa;关闭观察不终止研究" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ROADMAP"><mxGeometry x="700" y="65" width="300" height="310" as="geometry"/></mxCell>
<mxCell id="P2-COLD" value="P2｜冷读与精简投影&#xa;&#xa;补 Host 准确水位读面&#xa;复用缓存、版本与租约&#xa;收拢检查点与必要事实&#xa;Trace 索引、勘察摘要&#xa;接口与状态变化分小 PR&#xa;&#xa;验收：新旧恢复语义等价" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ROADMAP"><mxGeometry x="1040" y="65" width="300" height="310" as="geometry"/></mxCell>
<mxCell id="P2-BUNDLE" value="P2｜独立组合包闭环&#xa;&#xa;迁预设／Skills／Host／UI&#xa;同时完成 Remote 自挂载&#xa;校验安装资源与来源配置&#xa;保持 academic 与历史 ID&#xa;&#xa;验收：普通 Web 可无学术&#xa;On／Off／再启用可恢复" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ROADMAP"><mxGeometry x="1380" y="65" width="300" height="310" as="geometry"/></mxCell>
<mxCell id="P3-SEAMS" value="P3｜收拢剩余接线&#xa;&#xa;预设中英文显示贡献&#xa;计划审核的业务呈现扩展&#xa;保留持久化兼容与生成链&#xa;登记必要的上游薄接线&#xa;&#xa;验收：升级接线范围收敛&#xa;真实研究与历史回归通过" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="ROADMAP"><mxGeometry x="1720" y="65" width="300" height="310" as="geometry"/></mxCell>
<mxCell id="ROADMAP-NOTE" value="阶段编号表示优先级与建议依赖，不是工期承诺。组合包搬迁与 Remote 自挂载必须共同达到最小可启停闭环。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="ROADMAP"><mxGeometry x="20" y="390" width="2000" height="30" as="geometry"/></mxCell>
<mxCell id="GUARDS" value="验收与边界：功能含义不变，性能收益需要独立测量" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="2000" width="2040" height="260" as="geometry"/></mxCell>
<mxCell id="INVARIANTS" value="必须保持的事实与恢复规则&#xa;批准身份、Brief／论文版本、批次配对、终结状态和补证尾部事实保持一致。&#xa;先调整读模型并递增 stateVersion；不为优化重写历史日志。&#xa;固定材料验证热／冷／重启等价，再验证小规模真实研究与内存成本。&#xa;领域勘察 WIP：新增结果与摘要规则须和本轮投影改造协调。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="GUARDS"><mxGeometry x="20" y="65" width="965" height="165" as="geometry"/></mxCell>
<mxCell id="DISABLE" value="组合包停用顺序与历史可用性&#xa;停止接收新 run → 已完成，或明确取消 → await 结算 → 应用 Off／卸载。&#xa;Off 配置保存与实际生效分开；无热更新时需重启。&#xa;保留 Session／缓存／历史身份；丰富学术视图与继续研究需重新启用。&#xa;preset 旧代保留不能保证被移除的 Host Controller 继续运行。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="GUARDS"><mxGeometry x="1025" y="65" width="995" height="165" as="geometry"/></mxCell>
<mxCell id="PAGE-NOTE" value="基线提交：8c480a981c；工作区另有领域勘察未提交改动。本页是源码审计后的目标设计，不代表改造或验收已经完成。&#xa;现有轻量进度、Q6 去重与主 watch 合并继续复用；多模型策略、并行 Agent 和外部纯上游发行另行规划。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="2290" width="2040" height="65" as="geometry"/></mxCell>
