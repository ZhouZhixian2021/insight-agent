<diagram id="academic-domain-evidence-loop" name="07 领域勘察与循环补证一体架构"><mxGraphModel dx="1960" dy="1690" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1690" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="07 领域勘察与循环补证一体架构" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#243342;fontStyle=1;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1840" height="48" as="geometry"/></mxCell>
<mxCell id="subtitle" value="组合目标架构｜绿色：复用已合入能力｜橙色：领域勘察本地实现｜蓝色虚线：规划增强｜核对日期：2026-11-03" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1840" height="48" as="geometry"/></mxCell>
<mxCell id="U-BASE" value="公共基座：审批、模型与来源接口、运行预算、会话记录和证据溯源" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="145" width="1840" height="150" as="geometry"/></mxCell>
<mxCell id="U-SHARED" value="复用已合入的模型调用、检索、会话存储、超时与部分成果保留能力。&#xa;领域勘察和循环补证共同关联计划、方向、问题、证据与报告；新增多轮调度和恢复记录仍属规划。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="U-BASE"><mxGeometry x="20" y="55" width="1800" height="75" as="geometry"/></mxCell>
<mxCell id="U-DISCOVERY" value="一、先勘察领域，再由用户决定深入研究哪些方向" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="1540" height="260" as="geometry"/></mxCell>
<mxCell id="U-SURVEY-APPROVAL" value="① 批准勘察计划&#xa;主题、范围、年份和版本&#xa;发现与遗漏复查查询&#xa;候选数量、查询与耗时预算&#xa;第一次用户批准" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="U-DISCOVERY"><mxGeometry x="20" y="60" width="310" height="175" as="geometry"/></mxCell>
<mxCell id="U-SURVEY" value="② 发现候选方向&#xa;检索标题摘要、复查遗漏&#xa;去重并核对日期与论文版本&#xa;模型归类，核验支持摘录&#xa;本阶段不提取全文研究证据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="U-DISCOVERY"><mxGeometry x="360" y="60" width="350" height="175" as="geometry"/></mxCell>
<mxCell id="U-MAP" value="③ 保存候选方向图谱&#xa;方向、出处、未分类论文与限制&#xa;无方向时调整勘察计划再审批&#xa;有可研究方向才拟定深研计划&#xa;标题摘要图谱不作为全文证据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="U-DISCOVERY"><mxGeometry x="740" y="60" width="350" height="175" as="geometry"/></mxCell>
<mxCell id="U-RESEARCH-APPROVAL" value="④ 批准深入研究计划&#xa;全部方向分配：深入／概览／不覆盖&#xa;深入方向配置问题、证据目标和预算&#xa;第二次用户批准，绑定准确的勘察身份&#xa;确定本轮范围与补检额度" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#fff5e6;strokeColor=#bc9049;strokeWidth=1;" vertex="1" parent="U-DISCOVERY"><mxGeometry x="1120" y="60" width="400" height="175" as="geometry"/></mxCell>
<mxCell id="U-RESEARCH" value="二、在获批范围内深入研究，围绕报告缺口循环补证" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="1540" height="730" as="geometry"/></mxCell>
<mxCell id="U-EVIDENCE" value="⑤ 证据采集与有效证据集&#xa;初次：检索、全文获取、证据提取&#xa;增量：核验后追加，保留原有材料&#xa;按论文版本、问题和方向关联" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="20" y="60" width="420" height="150" as="geometry"/></mxCell>
<mxCell id="U-ANALYZE" value="⑥ 分析与报告草稿&#xa;按方向与问题汇总有效依据&#xa;说明结论、引用及适用条件&#xa;【规划】补证后更新论断与报告" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#edf7f0;strokeColor=#6d947b;strokeWidth=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="550" y="60" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="U-CHECK" value="⑦ 逐方向检查报告质量&#xa;已有基础：证据目标与引用核查&#xa;【规划】检查论断、数字、条件与反证&#xa;形成可以补检或补读的缺口清单" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="1090" y="60" width="420" height="150" as="geometry"/></mxCell>
<mxCell id="U-DECIDE" value="⑧ 补证决策与范围检查&#xa;缺口是否在已批准研究范围内？&#xa;是否还有预算和新增信息空间？&#xa;决定继续补证、收尾或调整计划" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="1090" y="380" width="420" height="175" as="geometry"/></mxCell>
<mxCell id="U-SUPPLEMENT" value="⑨ 定向补检或补读&#xa;把缺口转成查询与阅读目标&#xa;优先补读已有材料，再按需找新论文&#xa;补齐论断依据、实验条件和相反证据&#xa;不得擅自扩大获批范围" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="550" y="380" width="440" height="175" as="geometry"/></mxCell>
<mxCell id="U-VERIFY" value="⑩ 核验并保存补充结果&#xa;核对来源、版本、原文与支持关系&#xa;去重、保留反证，失败保留旧成果&#xa;记录新增证据、未解决缺口及成本&#xa;有效结果追加到证据集，再次分析" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="20" y="380" width="420" height="175" as="geometry"/></mxCell>
<mxCell id="U-STOP-RULES" value="停止：达到获批要求，或预算耗尽、无新增有效信息、用户取消等。&#xa;每轮比较问题完整性、论断支持与额外成本，发现反证时允许修正旧结论。&#xa;未达到交付要求时披露限制和剩余缺口；补证失败不清空原有成果。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="20" y="610" width="970" height="95" as="geometry"/></mxCell>
<mxCell id="U-DELIVER" value="报告交付与剩余缺口&#xa;按批准要求判断正式报告或草稿&#xa;无有效证据不生成研究结论" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="U-RESEARCH"><mxGeometry x="1090" y="610" width="420" height="95" as="geometry"/></mxCell>
<mxCell id="U-REVIEW" value="范围变化与重新审批" style="swimlane;horizontal=1;startSize=40;collapsible=0;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243342;fontStyle=1;align=center;verticalAlign=middle;spacing=12;fillColor=#eaf0f6;strokeColor=#bdc8d3;strokeWidth=1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1640" y="350" width="260" height="1050" as="geometry"/></mxCell>
<mxCell id="U-REAPPROVE" value="重新审批后再执行&#xa;已有方向的范围变化&#xa;→ 回到深研审批&#xa;新增图谱之外的方向&#xa;→ 回到勘察审批" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="U-REVIEW"><mxGeometry x="20" y="60" width="220" height="175" as="geometry"/></mxCell>
<mxCell id="U-CLUE" value="新方向作为待审线索&#xa;说明来源与变更原因&#xa;不直接加入获批范围&#xa;不直接写成研究结论&#xa;新勘察后重新绑定计划" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="U-REVIEW"><mxGeometry x="20" y="300" width="220" height="150" as="geometry"/></mxCell>
<mxCell id="U-SCOPE-CHANGE" value="范围／方向改变&#xa;先保留已有成果&#xa;调整研究深度或范围&#xa;再次确认计划与预算&#xa;若新增方向不在图谱&#xa;先批准补充勘察" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f0f4fb;strokeColor=#8c9fbc;strokeWidth=1;dashed=1;" vertex="1" parent="U-REVIEW"><mxGeometry x="20" y="580" width="220" height="200" as="geometry"/></mxCell>
<mxCell id="U-IN-SCOPE" value="范围内补证&#xa;沿用已批准的边界&#xa;无需每轮重新审批&#xa;新增方向或扩大范围&#xa;才进入计划调整流程" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=center;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="U-REVIEW"><mxGeometry x="20" y="860" width="220" height="155" as="geometry"/></mxCell>
<mxCell id="U-DATA" value="数据贯通与恢复边界&#xa;勘察身份 → 方向 → 批准问题 → 证据 → 论断 → 报告版本&#xa;补证轮次、失败、已用预算和剩余缺口的持续记录属于循环增强规划。&#xa;勘察目前可复用保存结果，查询级中断续跑尚未实现。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="1450" width="900" height="145" as="geometry"/></mxCell>
<mxCell id="U-QUALITY" value="如何判断报告得到改善&#xa;对照补证前后：问题回答、论断支持、引用与数字准确性。&#xa;同时记录耗时与调用成本；只统计真实、可定位的有效证据。&#xa;以真实材料验收，不能承诺循环次数越多质量越高。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=#f7f8fa;strokeColor=#abb4bf;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1000" y="1450" width="900" height="145" as="geometry"/></mxCell>
<mxCell id="U-NOTE" value="图中保留现有、本地和规划状态。流程细节见第 04—06 页；完整多轮补证与范围调整调度尚待实现和真实验收。" style="text;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243342;fontStyle=0;align=left;verticalAlign=middle;spacing=12;fillColor=none;strokeColor=none;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="1620" width="1840" height="45" as="geometry"/></mxCell>
<mxCell id="u-1" source="U-SURVEY-APPROVAL" target="U-SURVEY" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u-2" source="U-SURVEY" target="U-MAP" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u-3" source="U-MAP" target="U-RESEARCH-APPROVAL" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u-4" source="U-RESEARCH-APPROVAL" target="U-EVIDENCE" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="640"/><mxPoint x="290" y="640"/></Array></mxGeometry></mxCell>
<mxCell id="u-5" source="U-EVIDENCE" target="U-ANALYZE" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u-6" source="U-ANALYZE" target="U-CHECK" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u-7" source="U-CHECK" target="U-DECIDE" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u-8" source="U-DECIDE" target="U-SUPPLEMENT" value="范围内" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20.5" as="offset"/></mxGeometry></mxCell>
<mxCell id="u-9" source="U-SUPPLEMENT" target="U-VERIFY" value="" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u-10" source="U-VERIFY" target="U-EVIDENCE" value="追加证据，再次分析" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1" as="offset"/></mxGeometry></mxCell>
<mxCell id="u-finish" source="U-DECIDE" target="U-DELIVER" value="达标或触发停止条件" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#708092;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Microsoft YaHei;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1.5" as="offset"/></mxGeometry></mxCell>
